# concrete_block_stack.repos -- the packages nested inside this repo.
#
#   vcs import . < concrete_block_stack.repos
#
# The crane_* architecture packages also live here but are pinned separately, by
# SHA, in the workspace-root cbs.repos. They are deliberately not listed twice.
#
# NOTE: the feat/jazzy branches below are LOCAL-ONLY -- not pushed, so a fresh
# clone cannot resolve them yet. They carry the Gazebo Classic -> gz port.
repositories:
  concrete_block_assembly_interfaces:
    type: git
    url: https://github.com/Geryyy/concrete_block_assembly_interfaces.git
    version: main
  concrete_block_assembly_planning:
    type: git
    url: https://github.com/Geryyy/concrete_block_assembly_planning.git
    version: main
  concrete_block_behavior_tree:
    type: git
    url: https://github.com/Geryyy/concrete_block_behavior_tree.git
    version: feat/jazzy
  concrete_block_motion_planning:
    type: git
    url: https://github.com/Geryyy/concrete_block_motion_planning.git
    version: main
  concrete_block_perception:
    type: git
    url: https://github.com/Geryyy/concrete_block_perception_ros.git
    version: feat/jazzy
  concrete_block_perception_interfaces:
    type: git
    url: https://github.com/Geryyy/concrete_block_perception_interfaces.git
    version: main
  concrete_block_rviz_plugins:
    type: git
    url: https://github.com/Geryyy/concrete_block_rviz_plugins.git
    version: main
  concrete_block_viz_common:
    type: git
    url: https://github.com/Geryyy/concrete_block_viz_common.git
    version: main
  concrete_block_world_model:
    type: git
    url: https://github.com/Geryyy/concrete_block_world_model.git
    version: main
  concrete_block_world_model_interfaces:
    type: git
    url: https://github.com/Geryyy/concrete_block_world_model_interfaces.git
    version: main
  ros2_yolos_cpp:
    type: git
    url: https://github.com/Geryyy/ros2_yolos_cpp.git
    version: main
  sam2_segmentation:
    type: git
    url: https://github.com/Geryyy/ros2_sam2_segmentation.git
    version: main
  concrete_block_detector:
    type: git
    url: https://github.com/Geryyy/concrete_block_detector.git
    version: main
  blockpose:
    type: git
    url: https://github.com/Geryyy/blockpose.git
    version: main
